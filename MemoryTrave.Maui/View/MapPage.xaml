<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:viewModel="using:MemoryTrave.Maui.ViewModel"
             x:DataType="viewModel:MapViewModel"
             x:Class="MemoryTrave.Maui.View.MapPage">
    
    <Grid>
        <mapsui:MapControl x:Name="MapControl" 
                           Map="{Binding Map}"/>
        
        <VerticalStackLayout 
            Margin="16" 
            Padding="12" 
            BackgroundColor="White" 
            Opacity="0.92"
            HorizontalOptions="Start" 
            VerticalOptions="End"
            Spacing="8"
            MaximumWidthRequest="200">
        
            <HorizontalStackLayout Spacing="10">
                <BoxView WidthRequest="18" HeightRequest="18" CornerRadius="4" Color="#4285F4" VerticalOptions="Center"/>
                <Label Text="My" FontSize="13" VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <BoxView WidthRequest="18" HeightRequest="18" CornerRadius="4" Color="#34A853" VerticalOptions="Center"/>
                <Label Text="Friends" FontSize="13" VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <BoxView WidthRequest="18" HeightRequest="18" CornerRadius="4" Color="#EA4335" VerticalOptions="Center"/>
                <Label Text="My+Friends" FontSize="13" VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <BoxView WidthRequest="18" HeightRequest="18" CornerRadius="4" Color="#FBBC04" VerticalOptions="Center"/>
                <Label Text="Other" FontSize="13" VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <BoxView WidthRequest="18" HeightRequest="18" CornerRadius="4" Color="#969696" VerticalOptions="Center"/>
                <Label Text="Empty" FontSize="13" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
        
        <Frame CornerRadius="25"
               Padding="0"
               HasShadow="True"
               BorderColor="#007AFF"
               BackgroundColor="White"
               HorizontalOptions="Start"
               VerticalOptions="Start"
               Margin="20,50,20,0"
               HeightRequest="50"
               WidthRequest="50"
               IsVisible="{Binding IsAuthButVisible}">
            
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding LoginTappedCommand}" />
            </Frame.GestureRecognizers>
            
            <Image Source="login_icon.png" 
                   WidthRequest="24" 
                   HeightRequest="24"
                   HorizontalOptions="Center" 
                   VerticalOptions="Center"/>
        </Frame>
    </Grid>
</ContentPage>